# URL del servicio de IA (backend-ia)
# En desarrollo no hace falta: Vite proxya /ia-api → localhost:8000
# VITE_IA_API_URL=http://localhost:8000

# API principal (.NET)
# Por defecto Vite proxya /api → producción (api.merceriamatilde.com).
# Para probar cambios del backend local, creá .env.local con:
VITE_API_PROXY_TARGET=http://localhost:5015
# Luego reiniciá `npm run dev`.
#
# Alternativa sin proxy (llamada directa):
# VITE_API_URL=http://localhost:5015/api

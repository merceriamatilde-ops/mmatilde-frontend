{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bo.merceriamatilde.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ia.merceriamatilde.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.merceriamatilde.com/api/:path*"
    },
    {
      "source": "/ia-api/:path*",
      "destination": "https://ia-api.merceriamatilde.com/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.merceriamatilde.com/api/seo/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
